{
  "name": "uniwind-benchmarks",
  "version": "1.0.0",
  "private": true,
  "description": "Benchmark repository for different React Native styling libraries",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "precommit": "bun run lint && bun run typecheck"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Unistyles-OSS/uniwind-benchmarks.git"
  },
  "keywords": [
    "react-native",
    "benchmark",
    "styling",
    "nativewind",
    "unistyles",
    "uniwind"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Unistyles-OSS/uniwind-benchmarks/issues"
  },
  "homepage": "https://github.com/Unistyles-OSS/uniwind-benchmarks#readme",
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "husky": "9.1.7",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.3.2",
  "overrides": {
    "lightningcss": "1.30.1",
    "metro-babel-transformer": "0.84.6",
    "metro-cache-key": "0.84.6",
    "metro-cache": "0.84.6",
    "metro-config": "0.84.6",
    "metro-core": "0.84.6",
    "metro-file-map": "0.84.6",
    "metro-minify-terser": "0.84.6",
    "metro-resolver": "0.84.6",
    "metro-runtime": "0.84.6",
    "metro-source-map": "0.84.6",
    "metro-symbolicate": "0.84.6",
    "metro-transform-plugins": "0.84.6",
    "metro-transform-worker": "0.84.6",
    "metro": "0.84.6",
    "ob1": "0.84.6"
  },
  "patchedDependencies": {
    "react-native-css-interop@0.2.7": "patches/react-native-css-interop@0.2.7.patch"
  }
}
